# Password of the Postgres container. `a4` is for local development only;
# on a server use a random one: openssl rand -hex 16 (hex, so it is safe inside the URL)
POSTGRES_PASSWORD=a4
# Used when the app runs outside Docker; keep the password the same as above
DATABASE_URL=postgresql+asyncpg://a4:a4@localhost:5432/a4
# Required, at least 32 characters: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
TIMEZONE=Europe/Berlin
# Optional floor name, shown in the header: "Round Robin <name>"
#FLOOR_NAME=
# Duties must be marked done by this hour on the day after the duty ended;
# each day's people are chosen right after it
DEADLINE_HOUR=8
# People put on kitchen duty each day; only one of them has to clean (whoever claims it first)
KITCHEN_PEOPLE_PER_DAY=2
TRASH_PEOPLE_PER_WEEK=1
STRIKE_THRESHOLD=3
# Optional: first floor speaker, created on startup if there are no users yet
# (or create it by hand with scripts/create_admin.py). Password: at least 8 characters
#ADMIN_USERNAME=
#ADMIN_PASSWORD=
#ADMIN_NAME=
# Room like E103: letter, floor, room 01-99
#ADMIN_ROOM=
# Send the login cookie only over HTTPS; turn on when the app is behind TLS (reverse proxy)
#SECURE_COOKIES=true
