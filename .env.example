# Password of the Postgres container. `e1` is for local development only;
# on a server use a random one: openssl rand -hex 16 (hex, so it is safe inside the URL)
POSTGRES_PASSWORD=e1
# Database user and name (default e1). Only used when the database is first created;
# for an existing database set them to the ones it was created with.
#POSTGRES_USER=e1
#POSTGRES_DB=e1
# Used when the app runs outside Docker; keep user, password and name the same as above
DATABASE_URL=postgresql+asyncpg://e1:e1@localhost:5432/e1
# Required, at least 32 characters: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
TIMEZONE=Europe/Berlin
# Optional floor name, shown in the header: "Round Robin <name>"
#FLOOR_NAME=
# Duties must be marked done by this hour on the day after the duty ended;
# each day's people are chosen right after it
DEADLINE_HOUR=8
# People put on kitchen duty each day; only one of them has to clean (whoever claims it first)
KITCHEN_PEOPLE_PER_DAY=2
TRASH_PEOPLE_PER_WEEK=1
STRIKE_THRESHOLD=3
# Minutes after an emptying of the dishwasher before the next one can be marked
DISHWASHER_COOLDOWN_MINUTES=90
# The month's top dishwasher emptiers who get the next month off kitchen duty
DISHWASHER_HEROES=2
# Optional: first floor speaker, created on startup if there are no users yet
# (or create it by hand with `python -m scripts.create_admin`). Password: at least 8 characters
#ADMIN_USERNAME=
#ADMIN_PASSWORD=
#ADMIN_NAME=
# Room like E103: letter, floor, room 01-99
#ADMIN_ROOM=
# Send the login cookie only over HTTPS; turn on when the app is behind TLS (reverse proxy)
#SECURE_COOKIES=true
